# Ignore Gradle project-specific cache directory
.gradle
.vscode
.claude
app/bin/*
# Ignore Gradle build output directory
build
.idea
# Eclipse's own project metadata, alongside .idea and .vscode above
.project
.settings
result.md
*.class
# The lowered instruction list of each fixture, written next to its source on every test run so it
# can be read alongside App.java and truth.md. Nothing asserts on it - see LoweringTest.write.
app/src/test/resources/*/ir.txt
# The same fixture as the interactive React Flow page, written on every test run beside the Mermaid
# in truth.md. Nothing asserts on it either - see AppTest.writePage - and each one inlines its own
# copy of the bundled libraries, so they are megabytes apiece and are not committed.
app/src/test/resources/*/graph.html
# The same payload as a file the viewer's Node tests can read, written beside graph.html on every
# run. `npm test` sweeps these for reachability - see app/src/test/js/unit/reachability.test.ts.
app/src/test/resources/*/graph.json
# The viewer's browser bundles are built into app/src/main/resources/viewer and committed;
# node_modules only exists to build them and to run the JS tests.
node_modules
test-results