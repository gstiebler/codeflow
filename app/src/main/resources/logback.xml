<configuration>
    <!-- Diagnostics belong with the other diagnostics on stderr: stdout is the exported document,
         and a log line in the middle of it is not something a viewer can be asked to skip past.
         ConsoleAppender writes to System.out unless told otherwise. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="debug">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
