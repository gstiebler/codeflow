{
  "name": "codeflow-viewer",
  "private": true,
  "description": "Tooling for the interactive viewer: vendored browser libraries and the JS tests. The Kotlin build does not depend on any of this.",
  "scripts": {
    "test": "node --test app/src/test/js/unit/*.test.mjs",
    "test:browser": "playwright test --config=app/src/test/js/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@xyflow/react": "^12.11.2",
    "cytoscape": "^3.30.2",
    "cytoscape-elk": "^2.2.0",
    "elkjs": "^0.9.3",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
