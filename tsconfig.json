{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "app/src/main/resources/viewer/**/*.ts",
    "app/src/main/resources/viewer/**/*.tsx",
    "app/src/test/js/**/*.ts"
  ]
}
